---
import { goal } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<!-- Cierre del portfolio antes del contacto: título a la izquierda, texto a la derecha alineado abajo
     (en celular, apilados) -->
<section id="hacia-donde-voy" aria-labelledby="meta-titulo">
  <div class="mx-auto grid max-w-7xl gap-4 px-4 py-12 md:py-16 lg:grid-cols-2 lg:items-end lg:gap-14 lg:px-8">
    <SectionHeading id="meta-titulo" title={goal.title} />
    <p class="max-w-xl text-xl leading-snug text-cream/90 md:text-2xl lg:justify-self-end">{goal.text}</p>
  </div>
</section>
