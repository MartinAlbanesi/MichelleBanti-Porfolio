---
import { goal } from '../data/content';
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';

type Item = (typeof goal.items)[number];

// Fotos de cada paso: src/assets/hacia-donde-voy/<file>
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hacia-donde-voy/**/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photosOf = (item: Item) =>
  (item.photos ?? []).flatMap((p) => {
    const src = files[`../assets/hacia-donde-voy/${p.file}`]?.default;
    return src ? [{ src, alt: p.alt }] : [];
  });

// El orden solo pone primero lo que está en marcha
const order = { 'En curso': 0, Próximo: 1, Hecho: 2 };
const items = [...goal.items].sort((a, b) => order[a.status] - order[b.status]);
const tone = (s: Item['status']) => (s === 'En curso' ? 'status-live' : s === 'Hecho' ? 'status-done' : 'status-next');
---

<section id="hacia-donde-voy" aria-labelledby="meta-titulo">
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16 lg:px-8">
    <SectionHeading id="meta-titulo" title={goal.title} />
    <p class="mt-4 max-w-3xl text-xl leading-snug text-cream/90 md:text-2xl">{goal.text}</p>

    <!-- Cada paso: estado, título y texto arriba; sus fotos verticales debajo, todas del mismo tamaño
         (2 por fila en celular, 4 en md+) -->
    <div class="mt-10 space-y-14 md:mt-12 md:space-y-16">
      {items.map((item) => {
        const photos = photosOf(item);
        return (
          <article>
            <p class:list={['status', tone(item.status)]}>
              {item.status}
              {item.date && <span class="font-normal tabular-nums"> · {item.date}</span>}
            </p>
            <h3 class="mt-4 max-w-3xl font-display text-2xl font-bold leading-[1.05] tracking-[-0.025em] md:text-3xl lg:text-4xl">
              {item.title}
            </h3>
            <p class="mt-2 max-w-3xl text-base leading-snug text-cream md:text-lg">{item.text}</p>
            {photos.length > 0 && (
              <ul class="mt-6 grid grid-cols-2 gap-3 md:mt-8 md:grid-cols-4 md:gap-4 lg:gap-6">
                {photos.map((pic) => (
                  <li class="photo">
                    {/* .zoomable: la vista ampliada de Journey.astro (celular/tablet) también toma estas fotos */}
                    <button type="button" class="zoomable" aria-label="Ampliar foto">
                      <Image
                        src={pic.src}
                        alt={pic.alt}
                        widths={[320, 480, 640, 900]}
                        sizes="(min-width: 1280px) 18rem, (min-width: 768px) 23vw, 46vw"
                        quality={76}
                      />
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Fotos verticales: 3:4, el mismo recorte para todas */
  .photo {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--color-wine);
  }
  .zoomable {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    cursor: zoom-in;
  }
  @media (min-width: 1024px) {
    .zoomable {
      cursor: default;
    }
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .photo:hover :global(img) {
      scale: 1.04;
    }
  }
  .status {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    border: 2px solid var(--color-cream);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
  }
  /* En curso: gravel, el acento de la sección */
  .status-live {
    background: var(--color-gravel);
    border-color: var(--color-gravel);
    color: var(--color-ink);
  }
  .status-done {
    background: var(--color-ink);
    color: var(--color-cream);
  }
  .status-next {
    background: var(--color-cream);
    color: var(--color-ink);
  }
</style>
