---
import { Image } from 'astro:assets';
import bancaLogo from '../assets/BANCA/1-banca.jpg';
import bancaFiesta from '../assets/BANCA/2-banca.jpeg';
import bancaBaile from '../assets/BANCA/3-banca.jpeg';
import teatro1 from '../assets/TEATRO/1-teatro.jpeg';
import teatro2 from '../assets/TEATRO/2-teatro.jpeg';
import teatroLogo from '../assets/TEATRO/3-teatro.jpg';
import { now, type Project } from '../data/content';
import { icons } from '../data/icons';
import SectionHeading from './SectionHeading.astro';

// "Dónde estoy": un proyecto por pantalla, texto a la izquierda y collage a la derecha.
// Cada diapositiva tiene su color; a la derecha se asoma una franja del proyecto siguiente con una flecha.
// Collage según las fotos: [0] tarjeta inclinada, [1] foto ancha en perspectiva, [2] círculo (opcional).
type Pic = { src: ImageMetadata; alt: string; pos?: string };
const visuals: Record<string, { bg: string; pics: Pic[] }> = {
  banca: {
    bg: 'bg-terracotta',
    pics: [
      { src: bancaFiesta, alt: 'Michelle trabajando con una notebook en una fiesta al aire libre', pos: '50% 65%' },
      { src: bancaBaile, alt: 'Un grupo bailando en un evento de BANCA', pos: '50% 40%' },
      { src: bancaLogo, alt: 'Logo de BANCA Producciones' },
    ],
  },
  teatro: {
    bg: 'bg-ink',
    pics: [
      { src: teatro1, alt: 'Elenco de la obra posando en una galería de paredes amarillas', pos: '50% 40%' },
      { src: teatro2, alt: 'Elenco de la obra en otra toma de la misma galería', pos: '50% 30%' },
      { src: teatroLogo, alt: 'Logo de Las Mariposas de la Oscuridad: una mariposa violeta sobre un atardecer en el mar' },
    ],
  },
};
const projects: Project[] = now.projects;
const total = projects.length;
const bgOf = (i: number) => visuals[projects[i % total].id]?.bg ?? 'bg-terracotta';
---

<section id="ahora" aria-labelledby="ahora-titulo" class="now relative overflow-x-clip bg-ink text-paper">
  <!-- Título fijo encima del carrusel: misma geometría que el contenido de cada diapositiva,
       así queda alineado con el texto y no se mueve al pasar de proyecto -->
  <div class="pointer-events-none absolute left-0 top-0 z-10 grid w-[calc(100%-var(--peek))] grid-cols-[var(--peek)_1fr] pt-[var(--head-pos,var(--head-top))]" data-now-head>
    <div class="col-start-2 mx-auto w-full max-w-7xl px-4 lg:pl-0 lg:pr-8">
      <SectionHeading id="ahora-titulo" title={now.title} />
    </div>
  </div>
  <div
    data-now-track
    role="region"
    aria-roledescription="carrusel"
    aria-label={now.title}
    class="flex snap-x snap-mandatory overflow-x-auto overflow-y-hidden overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {projects.map((project, i) => {
      const pics = visuals[project.id]?.pics ?? [];
      const [card, wide, circle] = pics;
      return (
        <article
          id={project.id}
          data-now-slide
          role="group"
          aria-roledescription="proyecto"
          aria-label={`${i + 1} de ${total}: ${project.title}`}
          class:list={['slide grid shrink-0 snap-start grid-cols-[var(--peek)_1fr]', bgOf(i)]}
        >
          <!-- Franja izquierda (escritorio): lugar de la flecha "anterior"; es lo que se asoma desde la diapositiva previa -->
          <div aria-hidden="true"></div>

          <div class="mx-auto grid w-full max-w-7xl items-start gap-4 lg:items-center px-4 pb-6 pt-[var(--head-space)] lg:pl-0 md:gap-10 md:pb-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14 lg:pr-8">
            <!-- Texto -->
            <div class="max-w-xl">
              <h3 class="section-title text-cream [font-size:clamp(2.25rem,6vw,4.25rem)]">{project.title}</h3>
              <div class="mt-4 space-y-3 md:mt-6">
                {project.paragraphs.map((p, j) => (
                  <p class:list={[j === 0 ? 'text-lg leading-snug md:text-xl' : 'text-base leading-relaxed text-paper/85 md:text-lg']}>{p}</p>
                ))}
              </div>
            </div>

            <!-- Collage: el alto manda (nunca más que la pantalla) y el ancho sale de la proporción -->
            <div class="collage relative mx-auto aspect-[4/3] max-h-[36svh] w-full md:aspect-[5/4] md:h-[min(46svh,26rem)] md:max-h-none md:w-auto md:max-w-full lg:mx-0 lg:ml-auto lg:h-[min(62svh,36rem)]">
              {wide && (
                <div class="pic wide absolute right-0 top-[14%] aspect-[16/11] w-[64%] overflow-hidden rounded-xl shadow-[0_20px_40px_-18px_rgb(0_0_0/0.7)]">
                  <Image src={wide.src} alt={wide.alt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 26rem, 60vw" quality={72} class="h-full w-full object-cover" style={`object-position:${wide.pos ?? '50% 50%'}`} />
                </div>
              )}
              {card && (
                <div class="pic card absolute left-[2%] top-[4%] aspect-[3/4] w-[46%] overflow-hidden rounded-[1.25rem] ring-4 ring-paper/15 shadow-[0_24px_48px_-16px_rgb(0_0_0/0.75)]">
                  <Image src={card.src} alt={card.alt} widths={[300, 480, 700]} sizes="(min-width: 1024px) 18rem, 42vw" quality={72} class="h-full w-full object-cover" style={`object-position:${card.pos ?? '50% 50%'}`} />
                </div>
              )}
              {circle && (
                <div class="pic circle absolute left-[32%] top-[42%] aspect-square w-[34%] overflow-hidden rounded-full bg-cream ring-[6px] ring-cream shadow-[0_20px_40px_-14px_rgb(0_0_0/0.75)]">
                  <Image src={circle.src} alt={circle.alt} widths={[240, 400]} sizes="(min-width: 1024px) 13rem, 32vw" quality={72} class="h-full w-full object-cover" style={`object-position:${circle.pos ?? '50% 50%'}`} />
                </div>
              )}
              <!-- Enlace a Instagram en la esquina libre del collage (abajo a la derecha, debajo de la foto ancha) -->
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link absolute bottom-[3%] right-[2%] inline-flex h-11 items-center gap-2 rounded-full bg-butter px-4 font-display text-sm font-bold text-ink shadow-[0_10px_24px_-10px_rgb(0_0_0/0.7)] transition-colors hover:bg-cream lg:h-12 lg:px-5 lg:text-base"
                  aria-label={`${now.visit}: ${project.title}, en Instagram (se abre en una pestaña nueva)`}
                >
                  <svg viewBox="0 0 24 24" class="ig size-5 lg:size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons.instagram} />
                  {now.visit}
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Flechas fijas de la sección (no se deslizan con los proyectos). Celular: arriba a la derecha, junto al título.
       Escritorio: "siguiente" sobre la franja que se asoma a la derecha y "anterior" en la franja izquierda.
       Sin siguiente en el último proyecto ni anterior en el primero. -->
  <button type="button" data-now-next aria-label="Ver siguiente proyecto" hidden class="peek-btn now-next">
    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </button>
  <button type="button" data-now-prev aria-label="Volver al proyecto anterior" hidden class="peek-btn now-prev">
    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
  </button>
</section>

<style>
  /* --peek: franja del proyecto siguiente que se asoma (solo escritorio; en celular y tablet, ancho completo)
     --head-space: lugar que reservan las diapositivas arriba para el título fijo (mismo clamp que SectionHeading) */
  .now {
    --peek: 0rem;
    --head-drop: clamp(1.25rem, 2.5svh, 2rem);
    --head-top: calc(2rem + var(--head-drop));
    --head-space: calc(var(--head-top) + clamp(2.5rem, 8vw, 5.5rem) * 0.92 + clamp(0.75rem, 1.5svh, 1.25rem));
  }
  @media (min-width: 768px) {
    .now {
      --head-top: calc(2.5rem + var(--head-drop));
    }
  }
  @media (min-width: 1024px) {
    .now {
      --peek: 5rem;
    }
  }
  /* Cada proyecto ocupa el ancho menos la franja del siguiente. El alto lo da el contenido, que está atado a svh
     (título + collage de máx. 62svh), así nunca pasa la pantalla y el título del proyecto queda pegado al de la sección */
  .slide {
    width: calc(100% - var(--peek));
  }
  /* El último no deja asomar nada: ocupa todo el ancho y reserva la franja como aire, con la misma geometría */
  .slide:last-child {
    width: 100%;
    padding-right: var(--peek);
  }

  .now-next,
  .now-prev {
    position: absolute;
    z-index: 20;
    top: calc(var(--head-top) - 0.125rem);
    right: 1rem;
  }
  .now-prev {
    right: 4.25rem;
  }
  .now-next[hidden] + .now-prev {
    right: 1rem;
  }
  @media (min-width: 1024px) {
    .now-next,
    .now-prev {
      top: 50%;
      translate: 0 -50%;
      right: calc((var(--peek) - 3.5rem) / 2);
    }
    .now-prev,
    .now-next[hidden] + .now-prev {
      right: auto;
      left: calc((var(--peek) - 3.5rem) / 2);
    }
  }

  /* Fotos del collage: crecen un poco al pasar el mouse (en celular, al tocarlas) y vuelven al salir.
     Usa la propiedad scale, aparte de transform, para no pisar la inclinación de cada foto */
  .pic {
    transition: scale 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    cursor: zoom-in;
  }
  /* Sin z-index: cada foto crece en su propia capa, sin pasar por encima de las demás */
  @media (hover: hover) {
    .pic:hover {
      scale: 1.08;
    }
  }
  .pic[data-zoom] {
    scale: 1.08;
  }
  @media (prefers-reduced-motion: reduce) {
    .pic {
      transition: none;
    }
  }

  .peek-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: var(--color-paper);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-paper) 45%, transparent);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .peek-btn[hidden] {
    display: none;
  }
  .peek-btn:hover {
    background: var(--color-butter);
    color: var(--color-ink);
    box-shadow: none;
  }
  @media (min-width: 1024px) {
    .peek-btn {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  /* Collage al estilo de la referencia: tarjeta inclinada, foto ancha en perspectiva, círculo encima */
  .card {
    transform: rotate(-3deg);
  }
  .wide {
    transform: perspective(900px) rotateY(-16deg);
    transform-origin: left center;
  }
  .circle {
    transform: rotate(4deg);
  }

  .ig {
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .link:hover .ig,
  .link:focus-visible .ig {
    transform: scale(1.15) rotate(-6deg);
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-now-track]');
  if (track) {
    const slides = [...track.querySelectorAll<HTMLElement>('[data-now-slide]')];
    const next = document.querySelector<HTMLButtonElement>('[data-now-next]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-now-prev]')!;
    const titleOf = (i: number) => slides[i].querySelector('h3')?.textContent?.trim() ?? '';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const last = slides.length - 1;
    const active = () => Math.min(last, Math.round(track.scrollLeft / (slides[0]?.offsetWidth || 1)));
    const go = (i: number) =>
      track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: reduce.matches ? 'auto' : 'smooth' });
    const sync = () => {
      const a = active();
      prev.hidden = a === 0;
      next.hidden = a === last;
      if (a > 0) prev.setAttribute('aria-label', `Volver a: ${titleOf(a - 1)}`);
      if (a < last) next.setAttribute('aria-label', `Ver siguiente proyecto: ${titleOf(a + 1)}`);
    };
    next.addEventListener('click', () => go(Math.min(last, active() + 1)));
    prev.addEventListener('click', () => go(Math.max(0, active() - 1)));
    // Pantallas táctiles: tocar una foto la agranda; tocar otra, la misma o fuera la devuelve
    if (matchMedia('(hover: none)').matches) {
      const pics = [...track.querySelectorAll<HTMLElement>('.pic')];
      document.addEventListener('click', (e) => {
        const hit = (e.target as HTMLElement).closest<HTMLElement>('.pic');
        const wasOn = hit?.hasAttribute('data-zoom');
        pics.forEach((p) => p.removeAttribute('data-zoom'));
        if (hit && !wasOn) hit.setAttribute('data-zoom', '');
      });
    }
    let raf = 0;
    track.addEventListener('scroll', () => (raf ||= requestAnimationFrame(() => ((raf = 0), sync()))), { passive: true });
    // Escritorio: el texto está centrado, así que el título fijo baja hasta quedar justo arriba del título de proyecto
    // más alto (el mismo para todos, así no se mueve). Es una capa absoluta: no cambia el alto de la sección.
    const head = document.querySelector<HTMLElement>("[data-now-head]")!;
    const wide = matchMedia("(min-width: 1024px)");
    const placeHead = () => {
      head.style.removeProperty("--head-pos");
      if (!wide.matches) return;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const base = head.getBoundingClientRect().top;
      const topOf = Math.min(...slides.map((s) => s.querySelector("h3")!.getBoundingClientRect().top - base));
      const h = (head.firstElementChild as HTMLElement).offsetHeight;
      const pos = topOf - h - 2.25 * rem;
      if (pos > parseFloat(getComputedStyle(head).paddingTop)) head.style.setProperty("--head-pos", `${pos}px`);
    };
    new ResizeObserver(placeHead).observe(track);
    sync();
  }
</script>
