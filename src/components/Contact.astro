---
import { contact } from '../data/content';
import { CONTACT_EMAIL, WHATSAPP_URL, WHATSAPP_DISPLAY } from '../data/site';
import { icons } from '../data/icons';
---

<!-- Cierre: título con el sobre animado (IconScout) y los dos datos de contacto con el mismo peso.
     Fondo crema: texto ink 14.4:1; el círculo gravel del sobre resalta sobre el crema. -->
<section id="contacto" class="on-light bg-cream text-ink">
  <div class="mx-auto max-w-7xl px-4 lg:px-8 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] py-14 md:py-20">
    <div class="flex items-center gap-3 sm:gap-4">
      <h2 class="section-title">{contact.title}</h2>
      <div data-letter aria-hidden="true" class="skeleton size-16 shrink-0 rounded-full sm:size-24 lg:size-28"></div>
    </div>

    <ul class="mt-10 grid gap-8 border-t-2 border-ink/25 pt-8 md:mt-12 md:grid-cols-2 md:gap-10 md:pt-10">
      <li>
        <p class="label">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons.mail} />
          Email
        </p>
        <div class="flex items-center gap-1">
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-link" aria-label={`${contact.emailLabel}: ${CONTACT_EMAIL}`}>
            {CONTACT_EMAIL}
          </a>
          <!-- Copiar: solo el ícono, bordó translúcido; se oculta si no hay portapapeles -->
          <button type="button" data-copy={CONTACT_EMAIL} hidden class="copy" aria-label={contact.copy} title={contact.copy}>
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>
          </button>
        </div>
        <span data-copy-status class="mt-2 block min-h-5 font-display text-sm font-semibold" aria-live="polite"></span>
      </li>
      <li>
        <p class="label">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons.whatsapp} />
          {contact.whatsapp}
        </p>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
          aria-label={`${contact.whatsappLabel}: ${WHATSAPP_DISPLAY} (se abre en una pestaña nueva)`}
        >
          {WHATSAPP_DISPLAY}
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }
  /* El dato es lo protagonista: grande, subrayado; al pasar el mouse el subrayado se completa */
  .text-link {
    font-family: var(--font-display);
    /* Siempre en una línea: el tamaño sigue al ancho de su columna (cqi) para que el email, de ~16.4em,
       entre junto al ícono de copiar (3rem) */
    white-space: nowrap;
    font-size: clamp(0.875rem, calc((100cqi - 3rem) / 16.8), 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 45%, transparent);
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }
  /* Al pasar el mouse cambia a tostado (7.7:1 sobre crema) y el subrayado se completa */
  .text-link:hover,
  .text-link:focus-visible {
    color: var(--color-brown);
    text-decoration-color: currentColor;
  }
  .copy {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    /* 55%: lo justo para que el ícono siga pasando 3:1 sobre crema */
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    transition: color 0.2s;
  }
  .copy[hidden] {
    display: none;
  }
  .copy:hover,
  .copy:focus-visible {
    color: var(--color-ink);
  }
  li {
    container-type: inline-size;
  }
  @media (prefers-reduced-motion: reduce) {
    .text-link {
      transition: none;
    }
  }
</style>

<script>
  import { contact } from '../data/content';
  import { lazyLottie } from '../lib/lottie';

  // Sobre animado: se reproduce una vez al cargar (4,8 s) y otra vez al pasar el mouse.
  // Con "reducir movimiento" queda quieto en un cuadro donde el sobre ya se ve.
  const el = document.querySelector<HTMLElement>('[data-letter]');
  if (el)
    lazyLottie(
      el,
      () => import('../assets/valentine-letter.json'),
      // Cuadro 120 a 25 fps = 4,8 s: ahí el sobre ya está a la vista y se queda quieto
      { loop: false, autoplay: false },
      (anim, reduce) => {
        if (reduce) return anim.goToAndStop(120, true);
        const play = () => anim.playSegments([0, 120], true);
        play();
        el.closest('section')?.addEventListener('pointerenter', play);
      },
    );

  // Copiar email: solo con JS y portapapeles disponible; si no, el botón queda oculto y el email se lee en pantalla
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const status = btn.closest('li')?.querySelector<HTMLElement>('[data-copy-status]');
    if (!navigator.clipboard) return;
    btn.hidden = false;
    let timer = 0;
    btn.addEventListener('click', async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (status) status.textContent = contact.copied;
      } catch {
        if (status) status.textContent = contact.copyError;
      }
      timer = window.setTimeout(() => status && (status.textContent = ''), 3000);
    });
  });
</script>
