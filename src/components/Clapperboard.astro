---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 120 100" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect x="8" y="42" width="104" height="52" rx="3" class="fill-ink" />
  <rect x="16" y="52" width="40" height="5" class="fill-paper" />
  <rect x="16" y="64" width="64" height="5" class="fill-paper" />
  <rect x="16" y="76" width="50" height="5" class="fill-paper" />
  <g transform="rotate(-16 8 38)">
    <rect x="8" y="24" width="104" height="16" rx="3" class="fill-terracotta" />
    <path d="M24 24l-10 16h14l10-16zM52 24l-10 16h14l10-16zM80 24l-10 16h14l10-16z" class="fill-ink" />
  </g>
  <rect x="8" y="38" width="104" height="8" rx="2" class="fill-terracotta" />
</svg>
