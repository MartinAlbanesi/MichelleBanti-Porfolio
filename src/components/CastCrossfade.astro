---
// Fotos que se alternan con fundido cruzado. Por defecto, solo CSS (cada 3 s).
// Con `dots`: pasa a modo manual con JS: círculos clickeables arriba a la derecha y avance automático
// que se reinicia al elegir una foto. Admite 2 o 3 fotos. Por defecto, las dos del elenco.
import { Image } from 'astro:assets';
import cast1 from '../assets/TEATRO/1-teatro.jpeg';
import cast2 from '../assets/TEATRO/2-teatro.jpeg';

interface Props {
  class?: string;
  alt: string;
  dots?: boolean;
  images?: { src: ImageMetadata; pos?: string }[];
}
const {
  class: className = '',
  alt,
  dots = false,
  images = [
    { src: cast1, pos: '50% 40%' },
    { src: cast2, pos: '50% 30%' },
  ],
} = Astro.props;
const n = images.length;
---

<div
  class:list={['cast skeleton relative overflow-hidden bg-ink', className]}
  data-n={n}
  data-dots={dots ? '' : undefined}
  role={dots ? 'group' : 'img'}
  aria-label={alt}
>
  {images.map((im, i) => (
    <Image
      src={im.src}
      alt=""
      widths={[360, 540, 720]}
      quality={72}
      sizes="(min-width: 640px) 24rem, 82vw"
      class="cast-img"
      style={`object-position:${im.pos ?? '50% 50%'};--d:${i === 0 ? 0 : n - i}`}
    />
  ))}
  {dots && (
    <div class="cast-dots absolute right-2 top-2 z-10 flex">
      {images.map((_, i) => (
        <button type="button" data-dot={i} aria-label={`Foto ${i + 1} de ${n}`} class="dot">
          <span />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .cast-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  /* Sin movimiento: se ve solo la primera foto */
  .cast-img:first-child {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cast-img {
      animation: cast-fade-2 6s ease-in-out infinite;
      /* Cada foto arranca a su turno: cuando una sale, la siguiente entra */
      animation-delay: calc(var(--d) * -3s);
    }
    .cast[data-n='3'] .cast-img {
      animation-name: cast-fade-3;
      animation-duration: 9s;
    }
    @keyframes cast-fade-2 {
      0%,
      40% {
        opacity: 1;
      }
      50%,
      90% {
        opacity: 0;
      }
      100% {
        opacity: 1;
      }
    }
    @keyframes cast-fade-3 {
      0%,
      26.6% {
        opacity: 1;
      }
      33.3%,
      93.3% {
        opacity: 0;
      }
      100% {
        opacity: 1;
      }
    }
  }

  /* Modo manual (con círculos): el fundido lo manda data-active, no la animación CSS */
  .cast[data-manual] .cast-img {
    animation: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .cast[data-manual] .cast-img[data-active] {
    opacity: 1;
  }
  /* Círculos: área táctil de 28px, círculo de 12px, sin fondo; la sombra los despega de la foto */
  .cast-dots {
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.6));
  }
  .dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
  }
  .dot span {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid color-mix(in srgb, var(--color-cream) 80%, transparent);
    border-radius: 9999px;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }
  .dot:hover span {
    transform: scale(1.2);
  }
  .dot[aria-current='true'] span {
    background: color-mix(in srgb, var(--color-cream) 90%, transparent);
  }
</style>

<script>
  const AUTO_MS = 4000;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.cast[data-dots]').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLElement>('.cast-img')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    let cur = 0;
    let timer = 0;
    const show = (i: number) => {
      cur = (i + imgs.length) % imgs.length;
      imgs.forEach((im, j) => im.toggleAttribute('data-active', j === cur));
      dots.forEach((d, j) => d.setAttribute('aria-current', String(j === cur)));
    };
    const schedule = () => {
      clearTimeout(timer);
      if (!reduce) timer = window.setTimeout(() => (show(cur + 1), schedule()), AUTO_MS);
    };
    root.setAttribute('data-manual', '');
    show(0);
    schedule();
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        show(i);
        schedule();
      }),
    );
  });
</script>
