---
// Claqueta animada (Lottie). Mientras carga (o si falla), se ve la claqueta SVG estática.
import Clapperboard from './Clapperboard.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class={className} data-clapper aria-hidden="true">
  <Clapperboard class="size-full" />
</div>

<script>
  import { lazyLottie } from '../lib/lottie';
  const el = document.querySelector<HTMLElement>('[data-clapper]');
  // En bucle desde que carga la página (decisión de la dueña).
  // Con "reducir movimiento" queda quieta en el último fotograma
  if (el)
    lazyLottie(
      el,
      () => import('../assets/clapper.json'),
      {},
      (anim, reduce) => {
        if (reduce) anim.goToAndStop(anim.totalFrames - 1, true);
      },
    );
</script>
