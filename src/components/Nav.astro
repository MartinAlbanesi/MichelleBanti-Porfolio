---
import { nav, hero, contact } from '../data/content';
---

<!-- Centinela de 1px justo encima del índice: cuando sale por arriba, el índice quedó pegado -->
<div data-nav-sentinel aria-hidden="true" class="-mb-px h-px"></div>
<div aria-hidden="true" class="nav-bg"></div>
<nav aria-label="Índice" data-nav class="nav on-dark">
  <div class="nav-inner">
    <a href="#inicio" class="nav-brand">
      {hero.name}
    </a>
    <button type="button" class="nav-btn" aria-expanded="false" aria-controls="nav-links">
      Menú
    </button>
    <ul id="nav-links" class="nav-list">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="nav-link">
            <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
      <!-- Only visible in the floating (stuck) bar -->
      <li class="nav-cta-item">
        <a href="#contacto" class="nav-cta">
          {contact.title}
        </a>
      </li>
    </ul>
  </div>
</nav>
<!-- Reserva el alto que pierde el índice al compactarse: el contenido de abajo no se mueve -->
<div aria-hidden="true" class="nav-spacer"></div>

<style>
  /* .nav-bg pinta el hueco del índice en el flujo: así no se ve el papel entre el hero y la tira cuando el índice se pega arriba */
  .nav,
  .nav-bg {
    position: relative;
    z-index: 40;
    height: var(--nav-rest-h);
    /* En reposo: mismo grano que el hero para que no se vea la costura */
    background: var(--grain-light), var(--color-ink);
    color: var(--color-paper);
    box-shadow: inset 0 -1px 0 transparent;
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .nav {
    margin-top: calc(var(--nav-rest-h) * -1);
  }
  /* Pegajoso solo con JS: sin JS queda como lista normal en el flujo */
  .nav[data-ready] {
    position: sticky;
    top: 0;
  }
  .nav-inner {
    display: flex;
    height: 100%;
    max-width: 80rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }
  .nav-brand,
  .nav-btn {
    display: none;
  }
  .nav-brand {
    min-height: 2.75rem;
    align-items: center;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-paper);
    text-underline-offset: 4px;
  }
  .nav-brand:hover {
    color: var(--color-cream);
    text-decoration: underline;
  }
  .nav-btn {
    position: relative;
    min-width: 2.5rem;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-paper);
    transition: background-color 0.15s;
  }
  .nav-btn:hover {
    background: color-mix(in srgb, var(--color-paper) 20%, transparent);
  }
  /* El botón se ve de 40px, con aire dentro de la barra; el área táctil sigue siendo de 44px */
  .nav-btn::after {
    content: '';
    position: absolute;
    inset: -0.25rem;
  }
  .nav-list {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-link {
    display: flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.75rem;
    padding-inline: 1.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-paper);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .nav-link:hover {
    background: color-mix(in srgb, var(--color-paper) 20%, transparent);
    color: var(--color-cream);
  }
  /* Sección actual: resaltado leve */
  .nav-link[aria-current='true'],
  .nav-link[aria-current='true']:hover {
    color: var(--color-butter);
  }
  /* Marca inclinada (la misma de los roles del hero) en lugar de flecha */
  .nav-label::before {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.75rem;
    margin-right: 0.625rem;
    transform: skewX(-20deg);
    background: var(--color-butter);
  }
  .nav-cta-item {
    display: none;
  }
  .nav[data-stuck] .nav-cta-item {
    display: block;
  }
  .nav-cta {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding-inline: 1.25rem;
    border-radius: 9999px;
    background: var(--color-butter);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s;
  }
  .nav-cta:hover {
    background: var(--color-cream);
  }
  .nav-spacer {
    height: 0;
    background: var(--color-ink);
  }

  /* ---- Pegado: barra compacta ---- */
  /* Barra flotante: el contenedor es transparente y la barra con fondo es .nav-inner */
  .nav[data-stuck] {
    height: calc(var(--nav-h) + env(safe-area-inset-top));
    padding-top: calc(0.5rem + env(safe-area-inset-top));
    background: none;
    box-shadow: none;
  }
  .nav[data-stuck] .nav-inner {
    position: relative;
    /* Margen a los lados: la barra flotante no toca los bordes de la pantalla */
    width: calc(100% - 1.5rem - env(safe-area-inset-left) - env(safe-area-inset-right));
    height: calc(var(--nav-h) - 0.5rem);
    background: color-mix(in srgb, var(--color-ink) 94%, transparent);
    border-radius: 1rem;
    padding-inline: 1rem;
    box-shadow:
      0 8px 24px -10px rgb(0 0 0 / 0.55),
      inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 14%, transparent);
  }
  .nav[data-stuck] + .nav-spacer {
    height: max(0px, calc(var(--nav-rest-h) - var(--nav-h) - env(safe-area-inset-top)));
  }
  .nav[data-stuck] .nav-brand {
    display: flex;
  }
  /* Pegado: sin marca inclinada */
  .nav[data-stuck] .nav-label::before {
    display: none;
  }

  @media (max-width: 767.98px) {
    .nav[data-stuck] .nav-btn {
      display: inline-flex;
    }
    .nav[data-stuck] .nav-list {
      /* Cerrado: recortado hacia arriba; al abrir se despliega hacia abajo */
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
        visibility 0s linear 0.3s;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: auto;
      gap: 0;
      padding-left: max(1rem, env(safe-area-inset-left));
      padding-right: max(1rem, env(safe-area-inset-right));
      margin-top: 0.125rem;
      border-radius: 1rem;
      background: color-mix(in srgb, var(--color-ink) 97%, transparent);
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 14%, transparent),
        0 16px 24px -12px rgb(0 0 0 / 0.5);
    }
    .nav[data-stuck][data-open] .nav-list {
      visibility: visible;
      clip-path: inset(0 0 -2rem 0);
      transition-delay: 0s;
    }
    .nav[data-stuck] .nav-link {
      min-height: 2.75rem;
      padding-inline: 0;
      border-radius: 0;
      background: none;
      border-top: 1px solid color-mix(in srgb, var(--color-paper) 15%, transparent);
    }
    .nav[data-stuck] .nav-link:first-child,
    .nav[data-stuck] li:first-child .nav-link {
      border-top: 0;
    }
    .nav[data-stuck] .nav-link:hover {
      background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    }
    .nav[data-stuck] .nav-cta-item {
      padding-block: 0.25rem 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .nav-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .nav[data-stuck] .nav-list {
      display: flex;
      width: auto;
      flex-direction: row;
      gap: 0.25rem;
    }
    .nav[data-stuck] .nav-link {
      min-height: 2.75rem;
      padding-inline: 0.75rem;
      background: none;
      white-space: nowrap;
    }
    .nav[data-stuck] .nav-link:hover {
      background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    }
  }

  /* Tablet: brand + 4 links + CTA must fit in one row */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .nav[data-stuck] .nav-inner {
      gap: 0.5rem;
    }
    .nav[data-stuck] .nav-brand {
      white-space: nowrap;
    }
    .nav[data-stuck] .nav-list {
      gap: 0;
    }
    .nav[data-stuck] .nav-link {
      padding-inline: 0.5rem;
      font-size: 0.9375rem;
    }
    .nav[data-stuck] .nav-cta {
      padding-inline: 0.875rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 1024px) {
    .nav-list {
      grid-template-columns: repeat(4, 1fr);
    }
    /* Alinea las pastillas con el contenido del hero (que tiene 2rem a cada lado en lg+) */
    .nav:not([data-stuck]) .nav-inner {
      padding-inline: 2rem;
    }
    .nav-link {
      font-size: 1.125rem;
    }
    .nav[data-stuck] .nav-link {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav[data-stuck] .nav-inner {
      animation: nav-in 0.25s ease-out;
    }
    /* Al volver al hero el índice también aparece con fundido, no de golpe */
    .nav:not([data-stuck]) .nav-inner {
      animation: nav-rest-in 0.4s ease-out;
    }
    @keyframes nav-rest-in {
      from {
        opacity: 0;
      }
    }
    @keyframes nav-in {
      from {
        opacity: 0;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav-link,
    .nav-btn,
    .nav[data-stuck] .nav-list {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const sentinel = document.querySelector('[data-nav-sentinel]');
  const btn = nav?.querySelector<HTMLButtonElement>('.nav-btn');
  const list = nav?.querySelector('.nav-list');
  if (nav && sentinel && btn && list) {
    nav.setAttribute('data-ready', '');
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };
    // rootMargin enorme hacia abajo: el centinela cuenta como visible mientras no pasó el borde superior (también si el scroll salta)
    new IntersectionObserver(
      ([e]) => {
        const stuck = !e.isIntersecting;
        nav.toggleAttribute('data-stuck', stuck);
        if (!stuck) setOpen(false);
      },
      { rootMargin: '0px 0px 100000px 0px' },
    ).observe(sentinel);
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    // Sección actual: la última cuyo borde superior ya pasó el 40% de la pantalla
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('.nav-link')];
    const targets = links.map((l) => document.querySelector(l.getAttribute('href') || ''));
    const contactSection = document.getElementById('contacto');
    let raf = 0;
    const mark = () => {
      raf = 0;
      let cur = -1;
      targets.forEach((t, i) => {
        if (t && t.getBoundingClientRect().top <= innerHeight * 0.4) cur = i;
      });
      // In the contact section (short, so also when scrolled to the bottom) no index link is current
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      if (atBottom || (contactSection && contactSection.getBoundingClientRect().top <= innerHeight * 0.4)) cur = -1;
      links.forEach((l, i) => (i === cur ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));
    };
    addEventListener('scroll', () => (raf ||= requestAnimationFrame(mark)), { passive: true });
    mark();
    matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  }
</script>
