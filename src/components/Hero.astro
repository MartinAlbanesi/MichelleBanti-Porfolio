---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero-selfie.jpeg';
import { hero } from '../data/content';
import ClapperLottie from './ClapperLottie.astro';
import LottiePill from './LottiePill.astro';
import vinyl from '../assets/vinyl.svg?url';
import { INSTAGRAM_URL, LINKEDIN_URL, CV_URL } from '../data/site';
import { icons } from '../data/icons';

const [first, ...rest] = hero.name.split(' ');

// Motas de polvo del foco: posiciones fijas (semilla) dentro del trapecio del haz, con un poco de margen hacia afuera
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const motes = Array.from({ length: 22 }, () => {
  const t = 0.05 + rand() * 0.8; // alto: 0 arriba, 1 abajo
  const left = 88 + (4 - 88) * t;
  const right = 100 + (62 - 100) * t;
  const u = -0.1 + rand() * 1.2; // ancho: un 10% de cada lado cae fuera del haz
  return {
    x: +(left + u * (right - left)).toFixed(1),
    y: +(t * 100).toFixed(1),
    s: +(1.5 + rand() * 2.5).toFixed(1),
    d: +(7 + rand() * 7).toFixed(1),
    delay: -+(rand() * 14).toFixed(1),
    dx: Math.round(-20 + rand() * 40),
    dy: Math.round(-35 + rand() * 25),
  };
});
const socials = [
  {
    label: 'Instagram',
    href: INSTAGRAM_URL,
    icon: icons.instagram,
  },
  {
    label: 'LinkedIn',
    href: LINKEDIN_URL,
    icon: icons.linkedin,
  },
];
---

<section id="inicio" class="hero relative isolate overflow-hidden bg-ink text-cream">
  <div aria-hidden="true" class="hero-bg absolute inset-0 -z-10"></div>
  <!-- Foco de producción: haz de luz desde la esquina superior derecha que cae sobre el retrato -->
  <div aria-hidden="true" class="spot pointer-events-none absolute -z-10"></div>
  <!-- Polvo en el aire: motas que se encienden y apagan solo dentro (y apenas fuera) del haz -->
  <div aria-hidden="true" class="dust pointer-events-none absolute -z-10">
    {motes.map((m) => (
      <span style={`left:${m.x}%;top:${m.y}%;--s:${m.s}px;--d:${m.d}s;--delay:${m.delay}s;--dx:${m.dx}px;--dy:${m.dy}px`} />
    ))}
  </div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 gap-x-8 px-4 lg:px-8 pb-3 pt-6 md:pb-10 land:grid-cols-2 land:items-center lg:min-h-svh lg:grid-cols-[1.05fr_1fr] lg:content-center lg:gap-x-20 lg:pb-4 lg:pt-5">
    <!-- Retrato protagonista con el vinilo detrás; sello sobre el vinilo, lejos de la cara -->
    <div class="portrait relative order-2 mr-auto mt-8 w-[86%] max-w-[28rem] pl-[8%] land:col-start-2 land:row-start-2 land:mt-4 land:w-[78%] land:max-w-[15rem] land:pl-[6%] lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:ml-auto lg:mr-20 lg:mt-0 lg:max-w-none lg:w-[min(calc(100%-5rem),calc((100svh-6rem)*0.6))] lg:self-center lg:pl-0">
      <!-- Disco (IconScout) que gira sobre su propio eje, como si estuviera sonando -->
      <img
        src={vinyl}
        alt=""
        aria-hidden="true"
        class="vinyl absolute -bottom-4 -left-[4%] aspect-square w-[62%] sm:-left-14 lg:-left-[20%] lg:bottom-[10%] lg:w-[68%]"
      />
      <!-- Celular con las redes: arranca escondido detrás de la foto (va antes en el DOM, queda abajo)
           y al segundo se asoma a la derecha, con un leve vaivén como si alguien lo moviera -->
      <!-- Proporción de iPhone (~1:2,05), esquinas de ~16% del ancho, marco fino, Dynamic Island y botón lateral -->
      <div class="phone absolute right-1 top-[30%] flex aspect-[1/2.05] w-16 flex-col rounded-[0.7rem] bg-[#1c0003] p-[3px] shadow-[0_16px_32px_-12px_rgba(0,0,0,0.8)] ring-1 ring-cream/25 lg:w-20 lg:rounded-[0.85rem] lg:p-1">
        <span aria-hidden="true" class="absolute -right-[3px] top-[28%] h-[18%] w-[3px] rounded-r-sm bg-[#1c0003] ring-1 ring-cream/25"></span>
        <div class="flex flex-1 flex-col items-center justify-center gap-2 phone-screen rounded-[0.5rem] pt-2 lg:gap-3 lg:rounded-[0.6rem]">
          <span aria-hidden="true" class="absolute left-1/2 top-[7px] h-[5px] w-[32%] -translate-x-1/2 rounded-full bg-[#1c0003] lg:top-2.5 lg:h-1.5"></span>
          {socials.map((s) => (
            <a
              href={s.href}
              {...(s.href === '#'
                ? { 'aria-disabled': 'true', tabindex: -1 }
                : { target: '_blank', rel: 'noopener noreferrer' })}
              aria-label={s.label}
              class="inline-flex size-10 items-center justify-center rounded-xl text-white transition-colors hover:bg-white hover:text-ink aria-disabled:opacity-60 lg:size-14"
            >
              <svg
                viewBox="0 0 24 24"
                class="size-6 lg:size-8"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={s.icon}
              />
            </a>
          ))}
        </div>
      </div>
      <div class="relative aspect-[3/5] overflow-hidden rounded-2xl bg-wine shadow-[0_24px_48px_-20px_rgba(0,0,0,0.7)]">
        <Image
          src={heroPhoto}
          alt={hero.photoAlt}
          widths={[450, 640, 900]}
          quality={72}
          sizes="(min-width: 1152px) 560px, (min-width: 1024px) 48vw, (min-width: 640px) 416px, 84vw"
          loading="eager"
          fetchpriority="high"
          class="skeleton h-full w-full object-cover object-[30%_30%]"
        />
      </div>

      <!-- Sello circular: el texto gira, la claqueta queda quieta -->
      <div
        aria-hidden="true"
        class="absolute -bottom-4 -left-[4%] size-28 rounded-full bg-cream shadow-lg sm:-left-14 lg:-bottom-4 lg:-left-[10%] lg:size-32 xl:size-36"
      >
        <svg viewBox="0 0 120 120" class="badge-ring absolute inset-0 size-full" focusable="false">
          <defs>
            <path id="badge-circle" d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1-90 0"></path>
          </defs>
          <!-- xml:space="preserve": respeta los dobles espacios alrededor del "·" (SVG los colapsa a uno).
               textLength es solo el respaldo sin JS; el script de abajo ajusta el tamaño a la fuente real -->
          <text
            data-badge-text
            xml:space="preserve"
            font-size="11"
            font-weight="800"
            letter-spacing="0.04em"
            class="fill-ink"
            font-family="'Bricolage Grotesque Variable',system-ui,sans-serif"
          ><textPath href="#badge-circle" textLength="283" lengthAdjust="spacing">{hero.badge}</textPath></text>
        </svg>
        <ClapperLottie class="absolute left-1/2 top-1/2 w-[44%] -translate-x-1/2 -translate-y-1/2" />
      </div>
    </div>

    <!-- En celular el orden es: nombre, foto, detalles. En escritorio nombre y detalles van en la columna izquierda -->
    <div class="relative z-10 order-1 pt-2 land:col-span-2 land:row-start-1 lg:col-span-1 lg:col-start-1 lg:row-start-1 lg:self-end">
      <p
        class="hero-in font-hand text-4xl font-bold text-cream lg:[font-size:clamp(2rem,5.2svh,3.75rem)]"
        style="--d:0ms"
      >
        {hero.greeting}
      </p>
      <h1
        class="hero-in font-display font-extrabold uppercase leading-[0.86] tracking-tight text-cream [font-size:clamp(2.6rem,19vw,5.75rem)] sm:[font-size:clamp(4rem,14vw,8rem)] land:[font-size:clamp(2.5rem,8.5vw,4.5rem)] lg:[font-size:clamp(3.25rem,min(11.5vw,14svh),10.5rem)]"
        style="--d:80ms"
      >
        <span class="block land:inline">{first}</span> <span class="block land:inline">{rest.join(' ')}</span>
      </h1>
    </div>

    <div class="relative z-10 order-3 mt-10 land:col-start-1 land:row-start-2 land:mt-4 lg:col-start-1 lg:row-start-2 lg:mt-0 lg:self-start lg:pb-4">
      <ul
        class="hero-in flex flex-col items-start gap-1 font-display text-2xl font-extrabold leading-tight text-gravel sm:text-3xl lg:mt-4 lg:gap-1 lg:[font-size:clamp(1.75rem,4.6svh,2.75rem)]"
        style="--d:160ms"
      >
        {hero.roles.map((r) => <li>{r}</li>)}
      </ul>
      <div class="hero-in mt-3" style="--d:240ms">
        <p class="max-w-md text-xl leading-relaxed text-cream lg:max-w-xl lg:leading-normal lg:[font-size:clamp(1rem,2.7svh,1.25rem)]">
          {hero.tagline}
        </p>
        <div class="mx-auto mt-4 flex w-fit flex-wrap items-center justify-center gap-x-4 land:mx-0 lg:mx-0 gap-y-3 sm:gap-x-6 lg:mt-5 lg:grid lg:grid-cols-[14rem_14rem] lg:gap-3">
          <LottiePill href="#contacto">{hero.cta}</LottiePill>
          <LottiePill href={CV_URL} download="CV Michelle Banti.pdf">
            {hero.cv}
          </LottiePill>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Rueda del sello: en vez de forzar el texto al largo del círculo (en celular eso comprimía el espaciado),
  // mide el ancho real con la fuente ya cargada y escala la letra para que el texto dé una vuelta justa.
  // Así el espacio entre letras y alrededor del "·" queda igual en cualquier pantalla y con cualquier fuente.
  const text = document.querySelector<SVGTextElement>('[data-badge-text]');
  const path = text?.querySelector('textPath');
  const ring = document.querySelector<SVGPathElement>('#badge-circle');
  if (text && path && ring) {
    document.fonts.ready.then(() => {
      path.removeAttribute('textLength');
      path.removeAttribute('lengthAdjust');
      const size = parseFloat(text.getAttribute('font-size')!);
      const natural = text.getComputedTextLength();
      // Unidades del viewBox: no cambia con el tamaño en pantalla, solo con la fuente
      if (natural > 0) text.setAttribute('font-size', String((size * ring.getTotalLength()) / natural));
    });
  }
</script>

<style>
  /* Luz cálida detrás del retrato + grano claro liviano (tile pequeño, sin filtro a pantalla completa) */
  .hero-bg {
    background:
      var(--grain-light),
      /* Resplandor más claro desde la esquina superior derecha */
      radial-gradient(60rem 45rem at 100% 0%, #8a1c28 0%, transparent 65%),
      radial-gradient(48rem 40rem at 75% 45%, var(--color-wine) 0%, transparent 70%),
      var(--color-ink);
  }

  /* Haz de luz: trapecio angosto arriba a la derecha que se abre hacia abajo y a la izquierda, difuminado.
     Vaivén lento y un parpadeo mínimo, como un foco que alguien está apuntando */
  .spot {
    top: -8%;
    right: -4%;
    width: min(100%, 56rem);
    height: 120%;
    /* El blur va en el padre y el recorte en el hijo: si no, clip-path corta el blur y quedan bordes duros */
    filter: blur(22px);
    mix-blend-mode: screen;
    transform-origin: 94% 0;
    animation:
      spot-sway 9s ease-in-out infinite alternate,
      spot-flicker 6s steps(1) infinite;
  }
  .spot::before {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(88% 0, 100% 0, 62% 100%, 4% 100%);
    background: linear-gradient(to bottom, rgb(255 220 200 / 0.2), rgb(255 200 180 / 0.07) 55%, transparent 90%);
  }
  /* Misma caja y vaivén que el haz, para que el polvo se mueva con la luz; se apaga hacia abajo como el haz */
  .dust {
    top: -8%;
    right: -4%;
    width: min(100%, 56rem);
    height: 120%;
    transform-origin: 94% 0;
    animation: spot-sway 9s ease-in-out infinite alternate;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 88%);
  }
  .dust span {
    position: absolute;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: rgb(255 232 215);
    box-shadow: 0 0 6px 1px rgb(255 220 200 / 0.6);
    opacity: 0;
    animation: mote var(--d) ease-in-out var(--delay) infinite;
  }
  /* Entra en la luz, brilla un momento y se pierde mientras flota */
  @keyframes mote {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    35%,
    55% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      translate: var(--dx) var(--dy);
    }
  }
  @keyframes spot-sway {
    from {
      rotate: -2deg;
    }
    to {
      rotate: 2.5deg;
    }
  }
  @keyframes spot-flicker {
    0%,
    100% {
      opacity: 1;
    }
    47% {
      opacity: 0.9;
    }
    49% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spot,
    .dust {
      animation: none;
    }
    .dust {
      display: none;
    }
  }

  /* Pantalla del celular: degradé clay -> brown -> wine con un reflejo arriba, como vidrio.
     Íconos blancos: 5.4:1 sobre clay (lo más claro), más sobre el resto */
  .phone-screen {
    background:
      radial-gradient(120% 55% at 25% 0%, rgb(255 255 255 / 0.22), transparent 60%),
      linear-gradient(165deg, #a0553e 0%, var(--color-brown) 45%, var(--color-wine) 100%);
  }

  /* Cuánto se asoma el celular a la derecha de la foto (el resto queda detrás) */
  .phone {
    --peek: 3.75rem;
    transform: translateX(var(--peek)) rotate(3deg);
  }
  @media (min-width: 1024px) {
    .phone {
      --peek: 4.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--d, 0ms);
    }
    /* Giro continuo desde que carga (decisión de la dueña: sin pausa) */
    .badge-ring {
      animation: badge-spin 32s linear infinite;
    }
    .vinyl {
      animation: badge-spin 6s linear infinite;
    }
    /* Espera 1 s escondido y se asoma con un poco de envión y una leve inclinación, como en la mano */
    .phone {
      animation: phone-peek 0.9s cubic-bezier(0.3, 0.7, 0.3, 1) 1s both;
    }
    @keyframes phone-peek {
      from {
        transform: none;
      }
      65% {
        transform: translateX(calc(var(--peek) + 0.25rem)) rotate(5deg);
      }
      to {
        transform: translateX(var(--peek)) rotate(3deg);
      }
    }
    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
    }
    @keyframes badge-spin {
      to {
        transform: rotate(360deg);
      }
    }
  }
</style>
